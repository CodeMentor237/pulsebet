# PulseBet — Environment Variables
# Copy this file to .env.local and fill in your values

# The Odds API key (https://the-odds-api.com — free tier: 500 credits/month)
# Without this, the app runs in demo mode with simulated data
ODDS_API_KEY=

# Optional: set to 'true' to always use mock data (useful for local dev without burning credits)
USE_MOCK_DATA=false
